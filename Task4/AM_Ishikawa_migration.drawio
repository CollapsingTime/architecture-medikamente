<mxfile host="app.diagrams.net">
  <diagram name="Исикава миграция" id="medik-ishikawa-to-be">
    <mxGraphModel dx="2946" dy="1869" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ish-001" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="Миграция «Медикаменте»: узкие места и риски по методу Исикавы" vertex="1"><mxGeometry height="40" width="1300" x="40" y="30" as="geometry" /></mxCell>
        <mxCell id="ish-002" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeWidth=4;strokeColor=#333333;endSize=10;"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="600" as="sourcePoint" /><mxPoint x="1620" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-003" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" value="Риск: после миграции и открытия филиалов система работает нестабильно — запись к специалисту и поиск медкарты не выдерживают пятикратного роста" vertex="1"><mxGeometry height="200" width="340" x="1620" y="500" as="geometry" /></mxCell>
        <mxCell id="ish-004" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="1. Инфраструктура" vertex="1"><mxGeometry height="44" width="320" x="120" y="110" as="geometry" /></mxCell>
        <mxCell id="ish-005" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444444;"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="154" as="sourcePoint" /><mxPoint x="540" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-006" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="32.0" y="243.2" as="sourcePoint" /><mxPoint x="332.0" y="243.2" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-007" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="1.1 Вся инфраструктура держится на единственном сервере: резерва и отработанного восстановления нет" vertex="1"><mxGeometry height="56" width="300" x="32.0" y="247.2" as="geometry" /></mxCell>
        <mxCell id="ish-008" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="84.0" y="332.4" as="sourcePoint" /><mxPoint x="384.0" y="332.4" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-009" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="1.2 Через тот же сервер и офисный канал пойдут внешние посетители: портал и мобильное приложение" vertex="1"><mxGeometry height="56" width="300" x="84.0" y="336.4" as="geometry" /></mxCell>
        <mxCell id="ish-010" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="136.0" y="421.6" as="sourcePoint" /><mxPoint x="436.0" y="421.6" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-011" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="1.3 Шифрование дисков, полей и TLS добавляют нагрузку на текущее железо" vertex="1"><mxGeometry height="56" width="300" x="136.0" y="425.6" as="geometry" /></mxCell>
        <mxCell id="ish-012" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="188.0" y="510.8" as="sourcePoint" /><mxPoint x="488.0" y="510.8" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-013" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="1.4 ККМ, рабочие места и серверная сеть пока не разделены на сегменты" vertex="1"><mxGeometry height="56" width="300" x="188.0" y="514.8" as="geometry" /></mxCell>
        <mxCell id="ish-014" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="2. Программное обеспечение" vertex="1"><mxGeometry height="44" width="320" x="640" y="110" as="geometry" /></mxCell>
        <mxCell id="ish-015" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444444;"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="154" as="sourcePoint" /><mxPoint x="1060" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-016" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="552.0" y="243.2" as="sourcePoint" /><mxPoint x="852.0" y="243.2" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-017" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="2.1 Файловый режим 1С блокирует базу при одновременной работе кассиров и бухгалтерии" vertex="1"><mxGeometry height="56" width="300" x="552.0" y="247.2" as="geometry" /></mxCell>
        <mxCell id="ish-018" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="604.0" y="332.4" as="sourcePoint" /><mxPoint x="904.0" y="332.4" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-019" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="2.2 Поиск по зашифрованным ФИО и токенам без отдельного индекса выполняется медленно" vertex="1"><mxGeometry height="56" width="300" x="604.0" y="336.4" as="geometry" /></mxCell>
        <mxCell id="ish-020" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="656.0" y="421.6" as="sourcePoint" /><mxPoint x="956.0" y="421.6" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-021" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="2.3 Kubernetes, Postgres, ClickHouse и Elastic команда из трёх человек эксплуатирует впервые" vertex="1"><mxGeometry height="56" width="300" x="656.0" y="425.6" as="geometry" /></mxCell>
        <mxCell id="ish-022" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="708.0" y="510.8" as="sourcePoint" /><mxPoint x="1008.0" y="510.8" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-023" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="2.4 Новую систему ещё не проверяли нагрузочным тестом на пятикратный рост" vertex="1"><mxGeometry height="56" width="300" x="708.0" y="514.8" as="geometry" /></mxCell>
        <mxCell id="ish-024" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="3. Данные" vertex="1"><mxGeometry height="44" width="320" x="1160" y="110" as="geometry" /></mxCell>
        <mxCell id="ish-025" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444444;"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="154" as="sourcePoint" /><mxPoint x="1580" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-026" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1072.0" y="243.2" as="sourcePoint" /><mxPoint x="1372.0" y="243.2" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-027" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="3.1 Общего ключа у пациента в Excel нет: он размазан по журналам, сканам и реестрам" vertex="1"><mxGeometry height="56" width="300" x="1072.0" y="247.2" as="geometry" /></mxCell>
        <mxCell id="ish-028" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1124.0" y="332.4" as="sourcePoint" /><mxPoint x="1424.0" y="332.4" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-029" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="3.2 Имена файлов содержат ФИО и утекают в каталоги, логи и резервные копии" vertex="1"><mxGeometry height="56" width="300" x="1124.0" y="336.4" as="geometry" /></mxCell>
        <mxCell id="ish-030" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1176.0" y="421.6" as="sourcePoint" /><mxPoint x="1476.0" y="421.6" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-031" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="3.3 Сканы медкарт и договоров не размечены тегами, классифицировать их вручную долго" vertex="1"><mxGeometry height="56" width="300" x="1176.0" y="425.6" as="geometry" /></mxCell>
        <mxCell id="ish-032" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1228.0" y="510.8" as="sourcePoint" /><mxPoint x="1528.0" y="510.8" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-033" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;spacing=2;" value="3.4 Пока идёт переход, одни и те же данные существуют в трёх местах сразу: Excel, 1С и новая система" vertex="1"><mxGeometry height="56" width="300" x="1228.0" y="514.8" as="geometry" /></mxCell>
        <mxCell id="ish-034" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="4. Интеграция" vertex="1"><mxGeometry height="44" width="320" x="120" y="1046" as="geometry" /></mxCell>
        <mxCell id="ish-035" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444444;"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1046" as="sourcePoint" /><mxPoint x="540" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-036" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="32.0" y="956.8" as="sourcePoint" /><mxPoint x="332.0" y="956.8" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-037" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="4.1 ККМ и 1С связаны через OLE по TCP/IP — при росте чеков канал становится узким" vertex="1"><mxGeometry height="56" width="300" x="32.0" y="896.8" as="geometry" /></mxCell>
        <mxCell id="ish-038" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="84.0" y="867.6" as="sourcePoint" /><mxPoint x="384.0" y="867.6" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-039" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="4.2 Связь с лабораторией без API: обмен идёт файлами и реестрами в Excel" vertex="1"><mxGeometry height="56" width="300" x="84.0" y="807.6" as="geometry" /></mxCell>
        <mxCell id="ish-040" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="136.0" y="778.4" as="sourcePoint" /><mxPoint x="436.0" y="778.4" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-041" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="4.3 Обмен с 1С идёт без валидации схемы, контракты сторон не зафиксированы" vertex="1"><mxGeometry height="56" width="300" x="136.0" y="718.4" as="geometry" /></mxCell>
        <mxCell id="ish-042" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="188.0" y="689.2" as="sourcePoint" /><mxPoint x="488.0" y="689.2" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-043" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="4.4 Филиалы подключаются по внешним каналам, магистраль между площадками не спроектирована" vertex="1"><mxGeometry height="56" width="300" x="188.0" y="629.2" as="geometry" /></mxCell>
        <mxCell id="ish-044" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="5. Персонал" vertex="1"><mxGeometry height="44" width="320" x="640" y="1046" as="geometry" /></mxCell>
        <mxCell id="ish-045" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444444;"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1046" as="sourcePoint" /><mxPoint x="1060" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-046" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="552.0" y="956.8" as="sourcePoint" /><mxPoint x="852.0" y="956.8" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-047" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="5.1 IT-отдел всего из трёх человек, часть задач закрывают подрядчики" vertex="1"><mxGeometry height="56" width="300" x="552.0" y="896.8" as="geometry" /></mxCell>
        <mxCell id="ish-048" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="604.0" y="867.6" as="sourcePoint" /><mxPoint x="904.0" y="867.6" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-049" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="5.2 С Kubernetes и Postgres знаком только технический директор, администрирование — за одним админом" vertex="1"><mxGeometry height="56" width="300" x="604.0" y="807.6" as="geometry" /></mxCell>
        <mxCell id="ish-050" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="656.0" y="778.4" as="sourcePoint" /><mxPoint x="956.0" y="778.4" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-051" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="5.3 Персонал привык работать в Excel: ресепшен, кассиры и врачи на старте будут ошибаться" vertex="1"><mxGeometry height="56" width="300" x="656.0" y="718.4" as="geometry" /></mxCell>
        <mxCell id="ish-052" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="708.0" y="689.2" as="sourcePoint" /><mxPoint x="1008.0" y="689.2" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-053" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="5.4 Новый персонал филиалов приходит без опыта работы с медданными и ролями доступа" vertex="1"><mxGeometry height="56" width="300" x="708.0" y="629.2" as="geometry" /></mxCell>
        <mxCell id="ish-054" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="6. Процессы" vertex="1"><mxGeometry height="44" width="320" x="1160" y="1046" as="geometry" /></mxCell>
        <mxCell id="ish-055" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#444444;"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="1046" as="sourcePoint" /><mxPoint x="1580" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-056" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1072.0" y="956.8" as="sourcePoint" /><mxPoint x="1372.0" y="956.8" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-057" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="6.1 Работу с данными не измеряли: нет журналов и метрик для сравнения до и после" vertex="1"><mxGeometry height="56" width="300" x="1072.0" y="896.8" as="geometry" /></mxCell>
        <mxCell id="ish-058" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1124.0" y="867.6" as="sourcePoint" /><mxPoint x="1424.0" y="867.6" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-059" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="6.2 Поэтапного плана перехода с откатом нет, поэтому двойной ввод данных неизбежен" vertex="1"><mxGeometry height="56" width="300" x="1124.0" y="807.6" as="geometry" /></mxCell>
        <mxCell id="ish-060" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1176.0" y="778.4" as="sourcePoint" /><mxPoint x="1476.0" y="778.4" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-061" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="6.3 Наём, открытие филиалов и запуск MVP идут одновременно и требуют одних и тех же людей" vertex="1"><mxGeometry height="56" width="300" x="1176.0" y="718.4" as="geometry" /></mxCell>
        <mxCell id="ish-062" edge="1" parent="1" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#888888;"><mxGeometry relative="1" as="geometry"><mxPoint x="1228.0" y="689.2" as="sourcePoint" /><mxPoint x="1528.0" y="689.2" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ish-063" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=bottom;fontSize=12;spacing=2;" value="6.4 Регламент реагирования на инциденты и ответственный за ПДн к моменту миграции не назначены" vertex="1"><mxGeometry height="56" width="300" x="1228.0" y="629.2" as="geometry" /></mxCell>
      </root>
